VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Roadmap 037 — which environment this build is. Leave UNSET for production.
# Set to `staging` on Vercel's Preview environment. Rows written by a non-
# production build get tagged with it so the release cleanup can find them.
# Falls back to the hostname (localhost -> dev, stg-* -> staging) when unset.
VITE_ENV=
