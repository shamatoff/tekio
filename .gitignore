# Dependencies
node_modules/

# Build output
dist/

# Local env files
.env
.env.local
.env.*.local

# Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
*.log
npm-debug.log*

# TypeScript
*.tsbuildinfo

# Playwright ad-hoc tests (gitignored, used with MCP)
playwright-tests/

# Python (garmin-sync scripts run in CI; these are local-only artifacts)
__pycache__/
*.pyc
# Never commit Garmin tokens — they belong only in GitHub Actions secrets
.garminconnect/
garmin_tokens.json

# Local Claude Code config — contains secrets (Supabase PAT), never commit.
# .claude/ is otherwise tracked (agents + skills live there), so ignore by name.
.mcp.json
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Vercel CLI link (local, per-machine)
.vercel
