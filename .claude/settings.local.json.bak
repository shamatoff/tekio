{
  "env": {
    "CTX_GUARD_ROADMAP_DIR": "docs/roadmap/"
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "PowerShell(\\(Get-Command node -ErrorAction SilentlyContinue\\).Source; \\(Get-Command npm -ErrorAction SilentlyContinue\\).Source; $env:PATH)",
      "PowerShell(Get-ChildItem \"C:\\\\Program Files\\\\\" | Where-Object { $_.Name -match \"node\" }; Get-ChildItem \"C:\\\\Users\\\\topal\\\\AppData\\\\Local\\\\\" | Where-Object { $_.Name -match \"node|nvm|fnm|volta\" })",
      "PowerShell(Get-ChildItem \"C:\\\\Users\\\\topal\\\\\" | Select-Object Name; Get-ChildItem \"C:\\\\Users\\\\topal\\\\AppData\\\\Roaming\\\\\" | Where-Object { $_.Name -match \"npm|node\" } | Select-Object Name)",
      "PowerShell(winget --version 2>$null)",
      "PowerShell(winget install CoreyButler.NVMforWindows --accept-source-agreements --accept-package-agreements)",
      "PowerShell($env:PATH = [System.Environment]::GetEnvironmentVariable\\(\"PATH\", \"Machine\"\\) + \";\" + [System.Environment]::GetEnvironmentVariable\\(\"PATH\", \"User\"\\); nvm install lts)",
      "PowerShell([System.Environment]::GetEnvironmentVariable\\(\"PATH\", \"Machine\"\\) -split \";\" | Where-Object { $_ -match \"nvm\" })",
      "PowerShell($nvmHome = [System.Environment]::GetEnvironmentVariable\\(\"NVM_HOME\", \"Machine\"\\); $nvmHome)",
      "PowerShell($nvmHome = [System.Environment]::GetEnvironmentVariable\\(\"NVM_HOME\", \"Machine\"\\); $nvmSymlink = [System.Environment]::GetEnvironmentVariable\\(\"NVM_SYMLINK\", \"Machine\"\\); $env:PATH = \"$nvmHome;$nvmSymlink;\" + $env:PATH; & \"$nvmHome\\\\nvm.exe\" install lts)",
      "PowerShell($nvmHome = [System.Environment]::GetEnvironmentVariable\\(\"NVM_HOME\", \"Machine\"\\); Get-ChildItem $nvmHome -ErrorAction SilentlyContinue)",
      "PowerShell($nvmHome = [System.Environment]::GetEnvironmentVariable\\(\"NVM_HOME\", \"Machine\"\\); & \"$nvmHome\\\\nvm.exe\" install lts)"
    ]
  },
  "enabledMcpjsonServers": [
    "supabase"
  ],
  "enabledPlugins": {
    "session-flow@modus": true,
    "visual-iteration@modus": true
  }
}
